# Copy to .env and fill in. Real environment variables override this file.

# --- Server (server.py) ---
# Where builds, assets and the catalog are stored.
COOLIN_DATA_DIR=/dingo
# Admin panel login. The panel is disabled until a password is set.
COOLIN_ADMIN_USER=admin
COOLIN_ADMIN_PASSWORD=
# Address and port to listen on.
COOLIN_HOST=0.0.0.0
COOLIN_PORT=2665
# Set to 1 when running behind a reverse proxy (nginx, Cloudflare...) so rate limits see real client IPs.
COOLIN_TRUST_PROXY=0

# --- Launcher (launcher.py) ---
# Server the launcher talks to.
COOLIN_SERVER=https://coolin.yagmire.org/
